# systemd service for the chores calendar on the Raspberry Pi.
# Install: sudo cp server/chores-calendar.service /etc/systemd/system/
#          sudo systemctl enable --now chores-calendar
# Expects the app in /opt/chores-calendar (server/ and dist/ inside it).

[Unit]
Description=Household chores calendar
After=network.target

[Service]
User=pi
WorkingDirectory=/opt/chores-calendar
ExecStart=/usr/bin/node server/server.mjs
Environment=PORT=80
# Lets the server use port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure

[Install]
WantedBy=multi-user.target
